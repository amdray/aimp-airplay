#include <windows.h>
#pragma code_page(65001)
LANGUAGE LANG_RUSSIAN, SUBLANG_DEFAULT
101 DIALOGEX 0, 0, 218, 85
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "AirPlay"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Введите код с экрана Apple TV:", -1, 12, 12, 194, 14
    EDITTEXT 102, 12, 31, 194, 16, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Подключить", IDOK, 90, 60, 58, 16
    PUSHBUTTON "Отмена", IDCANCEL, 154, 60, 52, 16
END
