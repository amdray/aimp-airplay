+int rtspcl_pairing_post(struct rtspcl_s *p, const char *path, const unsigned char *body,
+                         int length, unsigned char *output, int capacity) {
+    key_data_t headers[] = {{"X-Apple-HKP", "4"}, {"Connection", "keep-alive"}, {NULL, NULL}};
+    char *response = NULL;
+    int size = 0;
+    bool ok = exec_request(p, "POST", "application/octet-stream", (char*) (length ? body : (const unsigned char*) ""),
+                           length, 1, headers, NULL, &response, &size, (char*) path);
+    if (!ok || size < 0 || size > capacity || (size && !response)) { free(response); return -1; }
+    if (size) memcpy(output, response, size);
+    free(response);
+    return size;
+}
